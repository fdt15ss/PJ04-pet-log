OPENAI_API_KEY=
LLM_EAGER_LOAD=1
LOCAL_LLM_AUTOSTART=1
LOCAL_LLM_RUNTIME=ollama
LOCAL_LLM_ROLE=primary
GEMMA_AUTO_PULL=1
GEMMA_PRELOAD=1
GEMMA_BASE_URL=
GEMMA_MODEL=gemma4:e4b
GEMMA_API_KEY=local-gemma
GEMMA_MAX_RETRIES=0
OPENAI_RECORD_STRUCTURING_MODEL=gpt-5-mini
OPENAI_RECORD_STRUCTURING_FALLBACK_MODEL=gpt-5-nano
OPENAI_RECORD_SUMMARY_MODEL=gpt-5-mini
OPENAI_RECORD_SUMMARY_FALLBACK_MODEL=
OPENAI_CARE_ANSWER_MODEL=gpt-5-mini
OPENAI_CARE_ANSWER_FALLBACK_MODEL=
OPENAI_PET_PERSONA_MODEL=gpt-5-mini
OPENAI_PET_PERSONA_FALLBACK_MODEL=
OPENAI_IMAGE_RECORD_UNDERSTANDING_MODEL=gpt-5-mini
OPENAI_IMAGE_RECORD_UNDERSTANDING_FALLBACK_MODEL=
OPENAI_CARE_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_SHOPPING_REASON_MODEL=gpt-5-mini
OPENAI_SHOPPING_REASON_FALLBACK_MODEL=gemma4:e4b
OPENAI_ACTION_NAVIGATION_MODEL=gpt-5-mini
OPENAI_ACTION_NAVIGATION_FALLBACK_MODEL=
OPENAI_SPEECH_TEXT_CORRECTION_MODEL=gpt-5-mini
OPENAI_SPEECH_TEXT_CORRECTION_FALLBACK_MODEL=

# --- 예시: RNGD(furiosa-llm) Qwen3 8B를 RNGD 서버 안에서 로컬로 쓸 때 ---
# 위 같은 이름의 값을 아래 값으로 바꾼다. 자세한 내용은 docs/llm-backend-benchmark.md 참고.
# - GEMMA_* 와 LOCAL_LLM_RUNTIME=ollama 는 이름만 그럴 뿐 OpenAI 호환 서버면 그대로 붙는다.
#   LOCAL_LLM_RUNTIME 은 ollama 외 값이면 오류가 나므로 바꾸지 않는다.
# - GEMMA_MODEL 은 curl http://127.0.0.1:8000/v1/models 의 id 값. ${GEMMA_MODEL} 로 한 곳만 바꾸면 된다.
# - Qwen3 8B는 텍스트 전용이라 사진 기록 이해(OPENAI_IMAGE_RECORD_UNDERSTANDING_MODEL)는 GPT를 유지한다.
# - GEMINI_API_KEY(또는 GOOGLE_API_KEY)가 있으면 gemini-2.0-flash 가 폴백으로 자동 추가된다.
#   RNGD 성능만 보려면 비워 둔다.
#
# LOCAL_LLM_AUTOSTART=0
# LOCAL_LLM_RUNTIME=ollama
# GEMMA_AUTO_PULL=0
# GEMMA_PRELOAD=0
# GEMMA_BASE_URL=http://127.0.0.1:8000/v1
# GEMMA_MODEL=REPLACE_WITH_RNGD_QWEN3_8B_MODEL_ID
# GEMMA_API_KEY=local-gemma
# OPENAI_RECORD_STRUCTURING_MODEL=${GEMMA_MODEL}
# OPENAI_RECORD_STRUCTURING_FALLBACK_MODEL=
# OPENAI_RECORD_SUMMARY_MODEL=${GEMMA_MODEL}
# OPENAI_CARE_ANSWER_MODEL=${GEMMA_MODEL}
# OPENAI_PET_PERSONA_MODEL=${GEMMA_MODEL}
# OPENAI_SHOPPING_REASON_MODEL=${GEMMA_MODEL}
# OPENAI_SHOPPING_REASON_FALLBACK_MODEL=
# OPENAI_ACTION_NAVIGATION_MODEL=${GEMMA_MODEL}
# OPENAI_SPEECH_TEXT_CORRECTION_MODEL=${GEMMA_MODEL}
# OPENAI_IMAGE_RECORD_UNDERSTANDING_MODEL=gpt-5-mini

WHISPER_MODEL=medium
EDGE_TTS_VOICE=ko-KR-SunHiNeural

NAVER_SHOPPING_CLIENT_ID=your-naver-client-id
NAVER_SHOPPING_CLIENT_SECRET=your-naver-client-secret
NAVER_SHOPPING_DISPLAY=3
NAVER_SHOPPING_SORT=sim
NAVER_SHOPPING_EXCLUDE=used:rental:cbshop
NAVER_SHOPPING_TIMEOUT=3

TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_TIMEOUT=3

GEMINI_API_KEY=your-gemini-api-key
